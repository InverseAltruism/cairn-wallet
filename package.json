{
  "name": "cairn-wallet",
  "version": "0.2.63",
  "description": "Cairn Wallet — a non-custodial browser wallet for Compute Substrate (CSD). Likely the first CSD wallet.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "package": "node build.mjs && node scripts/package.mjs",
    "test": "node test/run.mjs",
    "typecheck": "tsc --noEmit",
    "verify:vendor": "node scripts/check-vendor-fresh.mjs"
  },
  "dependencies": {
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0",
    "@scure/bip32": "1.7.0",
    "@scure/bip39": "1.6.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
